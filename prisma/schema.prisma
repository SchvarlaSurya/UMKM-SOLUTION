generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int                @id @default(autoincrement())
  email            String             @unique
  password         String
  nama             String
  createdAt        DateTime           @default(now())
  pengaturan       Pengaturan?
  usaha            Usaha?
  bahanBaku        BahanBaku[]
  biayaOperasional BiayaOperasional[]
  produk           Produk[]
  notifikasi       Notifikasi[]
}

model Usaha {
  id         Int    @id @default(autoincrement())
  userId     Int    @unique
  user       User   @relation(fields: [userId], references: [id])
  namaUsaha  String
  jenisUsaha String
}

model Pengaturan {
  id                    Int   @id @default(autoincrement())
  estimasiPorsiPerBulan Int   @default(1200)
  batasMarginAman       Float @default(10)
  userId                Int   @unique
  user                  User  @relation(fields: [userId], references: [id])
}

model BahanBaku {
  id             Int            @id @default(autoincrement())
  nama           String
  satuan         String
  hargaPerSatuan Float
  updatedAt      DateTime       @updatedAt
  userId         Int
  user           User           @relation(fields: [userId], references: [id])
  histori        HistoriHarga[]
  resep          Resep[]

  @@unique([userId, nama])
}

model HistoriHarga {
  id          Int       @id @default(autoincrement())
  bahanBakuId Int
  bahanBaku   BahanBaku @relation(fields: [bahanBakuId], references: [id])
  hargaLama   Float
  hargaBaru   Float
  tanggal     DateTime  @default(now())
}

model BiayaOperasional {
  id     Int    @id @default(autoincrement())
  nama   String
  jenis  String
  nilai  Float
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Produk {
  id                 Int                @id @default(autoincrement())
  nama               String
  kategori           String             @default("Umum")
  hargaJual          Float
  modePenentuanHarga String             @default("manual")
  targetMarginPersen Float?
  /// Cara pemilik memasukkan takaran resep: "per-porsi" atau "sekali-produksi".
  /// Resep tetap disimpan per porsi; ini hanya supaya form edit bisa dibuka
  /// kembali dengan angka yang sama seperti yang diketik pemiliknya.
  modeTakaran        String             @default("per-porsi")
  /// Jumlah porsi sekali produksi, hanya terisi kalau modeTakaran memakainya.
  jumlahPorsiProduksi Float?
  userId             Int
  user               User               @relation(fields: [userId], references: [id])
  resep              Resep[]
  snapshot           HppSnapshot[]
  historiHargaJual   HistoriHargaJual[]

  @@index([userId])
}

model Resep {
  produkId      Int
  bahanBakuId   Int
  jumlahDipakai Float
  produk        Produk    @relation(fields: [produkId], references: [id])
  bahanBaku     BahanBaku @relation(fields: [bahanBakuId], references: [id])

  @@id([produkId, bahanBakuId])
}

model HppSnapshot {
  id           Int      @id @default(autoincrement())
  produkId     Int
  produk       Produk   @relation(fields: [produkId], references: [id])
  hppTerhitung Float
  marginPersen Float
  dihitungPada DateTime @default(now())
}

model HistoriHargaJual {
  id        Int      @id @default(autoincrement())
  produkId  Int
  produk    Produk   @relation(fields: [produkId], references: [id])
  hargaLama Float
  hargaBaru Float
  alasan    String
  tanggal   DateTime @default(now())

  @@index([produkId])
}

model Notifikasi {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  judul       String
  pesan       String
  sudahDibaca Boolean  @default(false)
  tanggal     DateTime @default(now())

  @@index([userId, sudahDibaca])
}
